# 统一部署配置：只维护本文件，无需任何子项目 .env 或 Compose 覆盖文件。
# 复制为 .env 后填写真实凭据，chmod 600 .env；不要提交真实 .env。
# 含 $、#、空格或 JSON 的值用单引号包裹，避免 Compose 插值或截断。
# REGISTRY_* / KNOWLEDGE_* 分别只注入对应后端，同名模型参数可以独立设置。
# 容器内部数据库地址固定 mysql:3306；所有发布端口仅绑定宿主机回环。
# MySQL root 与业务密码必须非空且不同；模型、钉钉和中间件凭据按启用能力填写。

# 共用数据库、发布端口及平台连接
MYSQL_VERSION=8.4
MYSQL_DATABASE=registry
MYSQL_USER=registry
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
MYSQL_PORT=13306
BACKEND_PORT=16000
REGISTRY_FRONTEND_PORT=16080
KNOWLEDGE_BACKEND_PORT=15000
KNOWLEDGE_FRONTEND_PORT=15080
DINGTALK_CORP_ID=
MIDDLEWARE_BASE_URL=http://host.docker.internal:22000
KNOWLEDGE_ACCUMULATION_BASE_URL=http://knowledge-backend:8000

# 注册中心后端配置（REGISTRY_ 前缀由 Compose 去除）
REGISTRY_MYSQL_CONNECT_TIMEOUT_SECONDS=5
REGISTRY_MYSQL_OPERATION_TIMEOUT_SECONDS=10

# SQLite 本地数据文件，相对于项目根目录或容器工作目录。
REGISTRY_SQLITE_PATH=/workspace/data/review-log/registry.db

# OpenAI 配置；使用模型服务前填写实际密钥。
REGISTRY_OPENAI_API_KEY=
REGISTRY_OPENAI_BASE_URL=https://api.openai.com/v1
REGISTRY_MIDDLEWARE_PLATFORM_CODE=registry
REGISTRY_MIDDLEWARE_SECRET=
REGISTRY_MIDDLEWARE_RETRY_INTERVAL_SECONDS=30
# 中间件登录建立消息客户端最长约 30 秒，预留请求超时余量。
REGISTRY_MIDDLEWARE_REQUEST_TIMEOUT_SECONDS=40

# 平台目录：独立刷新平台列表及中间件会话存活状态，仅保存在内存。
REGISTRY_PLATFORM_DIRECTORY_ENABLED=true
REGISTRY_PLATFORM_DIRECTORY_REFRESH_INTERVAL_SECONDS=30
REGISTRY_PLATFORM_DIRECTORY_RETRY_INTERVAL_SECONDS=5
REGISTRY_PLATFORM_DIRECTORY_STALE_AFTER_SECONDS=90

# 中间件入库申请接收：拉取、下载和文件存储。
REGISTRY_INGESTION_ENABLED=true
REGISTRY_RESOURCE_ROOT=/workspace/data/resource
REGISTRY_REVIEW_LOG_ROOT=/workspace/data/review-log
REGISTRY_INGESTION_POLL_INTERVAL_SECONDS=2
REGISTRY_INGESTION_RETRY_INTERVAL_SECONDS=5
REGISTRY_INGESTION_DOWNLOAD_TIMEOUT_SECONDS=300
REGISTRY_INGESTION_MAX_FILE_BYTES=67108864

# 删除申请接收：引用正式资源，不下载或另存审核附件。
REGISTRY_DELETION_ENABLED=true
REGISTRY_DELETION_POLL_INTERVAL_SECONDS=2
REGISTRY_DELETION_RETRY_INTERVAL_SECONDS=5

# 入库工作流：相似文件召回。
REGISTRY_INGESTION_DUPLICATE_TOP_K=5
REGISTRY_INGESTION_DUPLICATE_MIN_SIMILARITY=0.8

# 入库工作流：并行重复性识别。
REGISTRY_INGESTION_COMPARISON_CONCURRENCY=10

# 自动入库和手动重荐共用配置；手动推荐不受 REGISTRY_INGESTION_ENABLED 开关控制。
# 通行证推荐：复用 MyVector HNSW 跨平台搜索；0.8 为待校准的临时值。
REGISTRY_PASSPORT_RECOMMENDATION_MIN_SIMILARITY=0.8
# HNSW 候选文件数量，范围 1 至 100；按阈值筛选后聚合通行证。
REGISTRY_PASSPORT_RECOMMENDATION_TOP_K=100

# 本地 vLLM 嵌入模型。
REGISTRY_VLLM_EMBEDDING_PROVIDER=vllm
REGISTRY_VLLM_EMBEDDING_BASE_URL=
REGISTRY_VLLM_EMBEDDING_API_KEY=
REGISTRY_VLLM_EMBEDDING_MODEL=qwen3-vl-embedding-8b
REGISTRY_VLLM_EMBEDDING_ENDPOINT=embeddings
REGISTRY_VLLM_EMBEDDING_TIMEOUT_SECONDS=60
REGISTRY_VLLM_EMBEDDING_BATCH_SIZE=32
REGISTRY_VLLM_EMBEDDING_MAX_CONCURRENT_REQUESTS=10
REGISTRY_VLLM_EMBEDDING_DIMENSIONS=4096
REGISTRY_VLLM_EMBEDDING_NORMALIZE=true

# 本地 vLLM 多模态模型与 PDF 页面引用。
REGISTRY_VLLM_MLLM_PROVIDER=vllm
REGISTRY_VLLM_MLLM_BASE_URL=
REGISTRY_VLLM_MLLM_API_KEY=
REGISTRY_VLLM_MLLM_MODEL=qwen38-flash-next
REGISTRY_VLLM_MLLM_ENDPOINT=chat_completions
REGISTRY_VLLM_MLLM_TIMEOUT_SECONDS=300
REGISTRY_VLLM_MLLM_MAX_CONCURRENT_REQUESTS=20
REGISTRY_VLLM_MLLM_USE_MEDIA_REFERENCES=true
REGISTRY_VLLM_MLLM_CONTEXT_WINDOW_TOKENS=262144
REGISTRY_VLLM_MLLM_ENABLE_THINKING=false
REGISTRY_VLLM_MLLM_REASONING_EFFORT=xhigh
REGISTRY_VLLM_MLLM_TEMPERATURE=0.7
REGISTRY_VLLM_MLLM_TOP_P=0.8
REGISTRY_VLLM_MLLM_TOP_K=20
REGISTRY_VLLM_MLLM_PRESENCE_PENALTY=1.5
REGISTRY_VLLM_MLLM_REPETITION_PENALTY=1.0
REGISTRY_VLLM_MLLM_SEED=3407
REGISTRY_VLLM_MLLM_MAX_COMPLETION_TOKENS=8192
REGISTRY_VLLM_MLLM_MAX_RENDER_SCALE=2.0
REGISTRY_VLLM_MLLM_VISUAL_TOKEN_PATCH_SIZE=32
REGISTRY_VLLM_MLLM_MAX_VISUAL_TOKENS_PER_PAGE=2048
REGISTRY_VLLM_MLLM_MAX_VISUAL_TOKENS_PER_DOCUMENT=65536
REGISTRY_VLLM_MLLM_MAX_VISUAL_TOKENS_PER_REQUEST=131072
REGISTRY_VLLM_MLLM_RESERVED_PROMPT_TOKENS=4096
REGISTRY_VLLM_MLLM_RESERVED_RUNTIME_TOKENS=10240
REGISTRY_VLLM_MLLM_MAX_PDF_PAGES=100
REGISTRY_VLLM_MLLM_MAX_PAGE_PIXELS=4000000
REGISTRY_VLLM_MLLM_MAX_PNG_BYTES=134217728
REGISTRY_SQLITE_BUSY_TIMEOUT_SECONDS=5

# 用户在 knowledge-accumulation-be 登录，registry 仅向中间件查询用户 token。
# 中央身份和本地人员查询的总超时（秒）；中间件不可用时返回 503。
REGISTRY_AUTH_REQUEST_TIMEOUT_SECONDS=5

# 文件判重 Agent（与消息接收及模型 HTTP 并发独立）。
REGISTRY_FILE_DEDUPLICATION_MAX_VISIBLE_PAGES=3
REGISTRY_FILE_DEDUPLICATION_MAX_ROUNDS=32
REGISTRY_FILE_DEDUPLICATION_MAX_CONSECUTIVE_ERRORS=3
REGISTRY_FILE_DEDUPLICATION_MAX_PAGE_READS=24
REGISTRY_FILE_DEDUPLICATION_MAX_OBSERVATIONS=128
REGISTRY_KNOWLEDGE_ACCUMULATION_TIMEOUT_SECONDS=10
REGISTRY_KNOWLEDGE_ACCUMULATION_AVATAR_MAX_BYTES=10485760

# 头像浏览器私有缓存时长，单位秒；0 表示不缓存。
REGISTRY_KNOWLEDGE_ACCUMULATION_AVATAR_CACHE_SECONDS=86400

# 钉钉通讯录手动刷新：更新已有员工姓名、全部一级部门、任职资料和在职状态。
# 明确查无此人标记离职，保留资料和权限；部署前确认 employees.employment_status 已迁移。
REGISTRY_DINGTALK_APP_KEY=
REGISTRY_DINGTALK_APP_SECRET=
# 生产填写宿主机可达的本地隧道代理地址，例如 http://host.docker.internal:18888；空值直连。
REGISTRY_DINGTALK_PROXY_URL=
REGISTRY_DINGTALK_TIMEOUT_SECONDS=10
REGISTRY_DINGTALK_REFRESH_TIMEOUT_SECONDS=300
REGISTRY_DINGTALK_REFRESH_MAX_CONCURRENCY=5

# 知识后端配置（KNOWLEDGE_ 前缀由 Compose 去除）
KNOWLEDGE_MIDDLEWARE_PLATFORM_CODE=knowledge-accumulation
KNOWLEDGE_MIDDLEWARE_SECRET=
# 登录可能等待消息客户端初始化约 30 秒，超时需覆盖该耗时。
KNOWLEDGE_MIDDLEWARE_REQUEST_TIMEOUT_SECONDS=40
KNOWLEDGE_MIDDLEWARE_RETRY_INTERVAL_SECONDS=30

# 启动自动按用户表→管理员表同步；首次登录缺资料时受控补登记，无独立启停开关。
# 必须使用与 registry 相同的权威人员源；完整范围及跨后端覆盖保护由部署侧保证。
KNOWLEDGE_MIDDLEWARE_USER_SYNC_OPERATION_TIMEOUT_SECONDS=30
KNOWLEDGE_MIDDLEWARE_USER_SYNC_RETRY_INTERVAL_SECONDS=30

# 登录作为核心能力直接装配；按 KNOWLEDGE_APP_ENV 配置开发凭据或生产钉钉凭据。
KNOWLEDGE_APP_ENV=production
# development 模式必填；作为 POST auth/login 的固定 Bearer 登录凭据。
# 该凭据须交换新随机用户 token；GET auth/me 只查中央，不会据此登录。
KNOWLEDGE_AUTH_DEVELOPER_ACCESS_TOKEN=
# 用户 token 的有效期与续期由中央控制，不配置本地 TTL。
KNOWLEDGE_AUTH_OPERATION_TIMEOUT_SECONDS=60
KNOWLEDGE_AUTH_MIDDLEWARE_TIMEOUT_SECONDS=5
# 开发 userid 绑定 SQL 员工时，以 SQL 姓名/权限/管理员关系为准；以下展示配置仅用于尚未落库的模拟身份。
KNOWLEDGE_AUTH_DEVELOPER_USERID=developer
KNOWLEDGE_AUTH_DEVELOPER_NAME='开发模拟用户'
KNOWLEDGE_AUTH_DEVELOPER_DEPARTMENT_ID=0
KNOWLEDGE_AUTH_DEVELOPER_DEPARTMENT_NAME='开发模拟部门'
KNOWLEDGE_AUTH_DEVELOPER_AVATAR_PATH=
KNOWLEDGE_AUTH_DEVELOPER_PERMISSIONS='{"registry":0}'
KNOWLEDGE_AUTH_DEVELOPER_MANAGED_PLATFORMS='[]'
KNOWLEDGE_DINGTALK_APP_KEY=
KNOWLEDGE_DINGTALK_APP_SECRET=
# 生产填写宿主机可达的本地隧道代理地址，例如 http://host.docker.internal:18888；空值直连。
KNOWLEDGE_DINGTALK_PROXY_URL=
KNOWLEDGE_DINGTALK_TIMEOUT_SECONDS=10

# 单聊机器人：复用上方钉钉应用凭据；KNOWLEDGE_ASSISTANT_ENABLED 统一控制 Stream 入站、消费和发送。
# RobotCode 从同一应用机器人配置获取，不默认猜测为 AppKey。
KNOWLEDGE_DINGTALK_ROBOT_CODE=
# 接收器仅负责可靠入队，不在回调中等待模型生成。
KNOWLEDGE_DINGTALK_ROBOT_CALLBACK_TIMEOUT_SECONDS=10
KNOWLEDGE_DINGTALK_ROBOT_RECONNECT_MAX_SECONDS=60
KNOWLEDGE_DINGTALK_ROBOT_MAX_PENDING_CALLBACKS=16
KNOWLEDGE_DINGTALK_ROBOT_MAX_FRAME_BYTES=1048576
KNOWLEDGE_DINGTALK_ROBOT_MAX_IMAGE_PIXELS=40000000
KNOWLEDGE_DINGTALK_ROBOT_MAX_IMAGE_FRAMES=100
KNOWLEDGE_DINGTALK_ROBOT_MAX_DOWNLOAD_BYTES=52428800
KNOWLEDGE_DINGTALK_ROBOT_DOWNLOAD_ALLOWED_HOSTS=dingtalk.com,alicdn.com,aliyuncs.com

# 助理队列传输：复用 MIDDLEWARE_BASE_URL 和已有平台会话；消费者由下方 KNOWLEDGE_ASSISTANT_ENABLED 控制。
KNOWLEDGE_ASSISTANT_QUEUE_TIMEOUT_SECONDS=40
KNOWLEDGE_ASSISTANT_QUEUE_MAX_FILES=10
KNOWLEDGE_ASSISTANT_QUEUE_MAX_FILE_BYTES=20971520
KNOWLEDGE_ASSISTANT_QUEUE_MAX_RESPONSE_BYTES=1048576

# 本开关同时启用钉钉 Stream 入站、提醒和空闲心跳调度。
KNOWLEDGE_ASSISTANT_ENABLED=false
KNOWLEDGE_ASSISTANT_POLL_SECONDS=3
# 尚未生成时模型分词服务暂不可用：保留任务，间隔重试，不确认消费。
KNOWLEDGE_ASSISTANT_MODEL_RETRY_SECONDS=30
# 可靠入站：整条消息暂存后确认；待发布/拒绝提示的扫描和重试。
KNOWLEDGE_ASSISTANT_INBOUND_POLL_SECONDS=3
KNOWLEDGE_ASSISTANT_INBOUND_RETRY_SECONDS=30
KNOWLEDGE_ASSISTANT_INBOUND_BATCH_SIZE=100
# 全局心跳策略：-1 关闭；正整数统一指定所有个人助理的心跳间隔（秒）。
KNOWLEDGE_ASSISTANT_HEARTBEAT_INTERVAL_SECONDS=300
# 调度器扫描频率，不改变实际心跳间隔。
KNOWLEDGE_ASSISTANT_HEARTBEAT_POLL_SECONDS=30
# 提醒扫描间隔、每批处理数量与发布重试间隔。
KNOWLEDGE_ASSISTANT_REMINDER_POLL_SECONDS=3
KNOWLEDGE_ASSISTANT_REMINDER_BATCH_SIZE=100
KNOWLEDGE_ASSISTANT_REMINDER_RETRY_SECONDS=30
# 每任务独立的助理查询结果 LRU：结果集数量、每页条数、单次最多保存条数。
KNOWLEDGE_ASSISTANT_DIRECTORY_CACHE_CAPACITY=10
KNOWLEDGE_ASSISTANT_DIRECTORY_PAGE_SIZE=10
KNOWLEDGE_ASSISTANT_DIRECTORY_MAX_RESULTS=1000
KNOWLEDGE_ASSISTANT_MAX_CONCURRENT_USERS=4
KNOWLEDGE_ASSISTANT_THINKING_EFFORT=medium
# 最终正文转换子智能体独立档位，默认 medium 开启推理；可选 none / low / medium / xhigh。
KNOWLEDGE_ASSISTANT_RENDERING_THINKING_EFFORT=medium
# 必须小于中间件发布幂等回执保留期；超出此窗口的未知发布结果停止自动重试。
KNOWLEDGE_ASSISTANT_PUBLICATION_RETRY_WINDOW_SECONDS=3600
KNOWLEDGE_MYSQL_CONNECT_TIMEOUT_SECONDS=5
KNOWLEDGE_MYSQL_OPERATION_TIMEOUT_SECONDS=10

# 仅真实运行允许使用 data/user/avatar，测试须显式覆盖为 tests/tmp 下目录。
KNOWLEDGE_AVATAR_ROOT=/workspace/data/user/avatar
KNOWLEDGE_AVATAR_MAX_DOWNLOAD_BYTES=10485760
KNOWLEDGE_AVATAR_MAX_PIXELS=16000000
KNOWLEDGE_AVATAR_TIMEOUT_SECONDS=10
KNOWLEDGE_AVATAR_ALLOWED_HOSTS=dingtalk.com,alicdn.com,aliyuncs.com

# 仅探索模式：中途反馈提醒间隔（秒，可为小数）；0关闭，默认60。成功emit_progress后重计，不打断运行中的模型或工具。
KNOWLEDGE_AGENT_PROGRESS_REMINDER_INTERVAL_SECONDS=60
# 以下 AGENT_* 容量、分页、展示轮次和图片预算以配置为准，只校验正整数，不另设代码最大值。
# Agent 文件模型 LRU 容量：每个服务自建池最多驻留的文件数，不是图片页数。
KNOWLEDGE_AGENT_FILE_CACHE_MAX_FILES=4
# 可折叠正文存活轮次：每次打开后可见的完整主模型响应次数，不是同时存在的图片数。
# 两项均为正整数；模式工厂构造时读取，修改后须重建服务或重启进程。
KNOWLEDGE_AGENT_PAGE_DISPLAY_ROUNDS=5

# 每棵用户问答树驻留的专家会话数；LRU 只驱逐空闲会话。
KNOWLEDGE_AGENT_EXPERT_SESSION_CACHE_MAX_SESSIONS=10

# 外部专家：独立于 vLLM，通过 Responses 使用服务端内置搜索。
# Key 留空不影响启动；首次求助时明确反馈未配置，不发请求。
KNOWLEDGE_DEEPSEEK_BASE_URL=https://api.deepseek.com
KNOWLEDGE_DEEPSEEK_API_KEY=
KNOWLEDGE_DEEPSEEK_MODEL=deepseek-v4-pro
# none / low / high / max；与用户本轮主模型的三档强度独立。
KNOWLEDGE_DEEPSEEK_REASONING_EFFORT=high
KNOWLEDGE_DEEPSEEK_TIMEOUT_SECONDS=300
KNOWLEDGE_DEEPSEEK_MAX_CONCURRENT_REQUESTS=3
KNOWLEDGE_DEEPSEEK_MAX_COMPLETION_TOKENS=8192

# 网页检索：共用 KNOWLEDGE_DEEPSEEK_BASE_URL/API_KEY，搜索与专家生成预算独立。
KNOWLEDGE_DEEPSEEK_SEARCH_TIMEOUT_SECONDS=45
KNOWLEDGE_DEEPSEEK_SEARCH_COUNT=10
KNOWLEDGE_DEEPSEEK_SEARCH_TRUST_ENV=false
# 每棵用户树的搜索/正文 LRU 容量及分页；正文与搜索页沿用 KNOWLEDGE_AGENT_PAGE_DISPLAY_ROUNDS。
KNOWLEDGE_AGENT_WEB_SEARCH_CACHE_MAX_QUERIES=10
KNOWLEDGE_AGENT_WEB_SEARCH_PAGE_SIZE=5
KNOWLEDGE_AGENT_WEB_SEARCH_MAX_CONCURRENT_REQUESTS=2
KNOWLEDGE_AGENT_WEB_PAGE_CACHE_MAX_ENTRIES=10
KNOWLEDGE_AGENT_WEB_PAGE_CHARS=3000
# 网页图像只在当前任务内存驻留；候选数、保留数、单图下载/标准化字节上限。
# 具体读取数量仍受下载和相关性筛选影响。
KNOWLEDGE_AGENT_WEB_IMAGE_MAX_CANDIDATES=6
KNOWLEDGE_AGENT_WEB_IMAGE_MAX_SELECTED=3
KNOWLEDGE_AGENT_WEB_IMAGE_MAX_BYTES=4194304

# 多模态主模型 vLLM：填写部署根地址或 /v1 地址；模型名须匹配服务的 served-model-name。
# 默认模型名及生成参数参考 contract-service-be；如服务别名不同请修改 MODEL。
# 探索问答 HTTP/SSE 按需装配模型；留空不影响身份接口，提交问答时返回不可用。
KNOWLEDGE_VLLM_MLLM_PROVIDER=vllm
KNOWLEDGE_VLLM_MLLM_ENDPOINT=chat_completions
KNOWLEDGE_VLLM_MLLM_BASE_URL=
KNOWLEDGE_VLLM_MLLM_MODEL=qwen38-flash-next
# 可选工具格式说明；关闭不读取文件、不改变原生 tools 或推理强度映射。
# 文件位于 assets/tool-tag，须匹配服务端模型、chat template 与 tool-call parser。
KNOWLEDGE_VLLM_MLLM_TOOL_TAG_ENABLED=true
KNOWLEDGE_VLLM_MLLM_TOOL_TAG_FILE=qwen3.8-flash-next-nvfp4.txt
KNOWLEDGE_VLLM_MLLM_API_KEY=
KNOWLEDGE_VLLM_MLLM_TIMEOUT_SECONDS=300
KNOWLEDGE_VLLM_MLLM_MAX_CONCURRENT_REQUESTS=20
KNOWLEDGE_VLLM_MLLM_CONTEXT_WINDOW_TOKENS=262144
KNOWLEDGE_VLLM_MLLM_ENABLE_THINKING=true
# 摘要主题发现/总结固定读取此配置；主任务仍由用户请求选择推理档位。
KNOWLEDGE_VLLM_MLLM_REASONING_EFFORT=xhigh
KNOWLEDGE_VLLM_MLLM_TEMPERATURE=0.7
KNOWLEDGE_VLLM_MLLM_TOP_P=0.8
KNOWLEDGE_VLLM_MLLM_TOP_K=20
KNOWLEDGE_VLLM_MLLM_PRESENCE_PENALTY=1.5
KNOWLEDGE_VLLM_MLLM_REPETITION_PENALTY=1.0
KNOWLEDGE_VLLM_MLLM_SEED=3407
KNOWLEDGE_VLLM_MLLM_MAX_COMPLETION_TOKENS=8192

# 向量模型 vLLM：填写地址即可使用默认模型；如服务别名不同请修改 MODEL。
# 配置地址后启动后台记忆向量化；留空不启用，已有 pending/failed 在配置后补处理。
# API key 无需认证时留空；更换模型或编码指令须显式重建历史向量。
KNOWLEDGE_VLLM_EMBEDDING_PROVIDER=vllm
KNOWLEDGE_VLLM_EMBEDDING_ENDPOINT=embeddings
KNOWLEDGE_VLLM_EMBEDDING_BASE_URL=
KNOWLEDGE_VLLM_EMBEDDING_MODEL=qwen3-vl-embedding-8b
# 须与 MyVector 索引列声明维度一致；更换模型需清理索引并重建全部记忆向量。
KNOWLEDGE_VLLM_EMBEDDING_DIMENSIONS=4096
KNOWLEDGE_VLLM_EMBEDDING_API_KEY=
KNOWLEDGE_VLLM_EMBEDDING_TIMEOUT_SECONDS=60
KNOWLEDGE_VLLM_EMBEDDING_BATCH_SIZE=32
KNOWLEDGE_VLLM_EMBEDDING_MAX_CONCURRENT_REQUESTS=10
KNOWLEDGE_VLLM_EMBEDDING_NORMALIZE=true

# 终态任务的公开消息分批加工；原生推理、工具回执和中断输出不参与。
KNOWLEDGE_MEMORY_EMBEDDING_BATCH_SIZE=32
KNOWLEDGE_MEMORY_EMBEDDING_SCAN_INTERVAL_SECONDS=30

# 当前问答内的记忆查询驻留和分页；任务结束释放，页面沿用 KNOWLEDGE_AGENT_PAGE_DISPLAY_ROUNDS 自动折叠。
KNOWLEDGE_AGENT_MEMORY_CACHE_MAX_QUERIES=10
KNOWLEDGE_AGENT_MEMORY_PAGE_SIZE=3
# 派生文件检索数据只在内存中；不建检索表，不依赖MyVector。
# 名称采用MySQL全文检索，摘要额外使用现有VLLM_EMBEDDING_*与MyVector精确距离。
KNOWLEDGE_FILE_RETRIEVAL_TOP_K=10
KNOWLEDGE_FILE_RETRIEVAL_CANDIDATE_MULTIPLIER=4
KNOWLEDGE_FILE_RETRIEVAL_CACHE_MAX_QUERIES=10
# 每进程保留的摘要向量数量；不限制单次授权候选范围，进程退出释放。
KNOWLEDGE_FILE_RETRIEVAL_CACHE_MAX_VECTORS=256
KNOWLEDGE_FILE_RETRIEVAL_PAGE_SIZE=5
KNOWLEDGE_FILE_RETRIEVAL_MAX_ROUNDS=16
KNOWLEDGE_FILE_RETRIEVAL_RRF_K=60
KNOWLEDGE_FILE_RETRIEVAL_HISTORY_WEIGHT=0.5

# 注册中心文件查看：填写HTTP/HTTPS根地址，路径由客户端固定拼接。
# 复用中间件平台会话认证，按可信任务userid读取；无独立下载密钥，留空时工具提示未配置。
KNOWLEDGE_REGISTRY_BASE_URL=http://backend:8000
KNOWLEDGE_REGISTRY_FILE_TIMEOUT_SECONDS=60
KNOWLEDGE_REGISTRY_FILE_MAX_DOWNLOAD_BYTES=52428800
# PDF模型驻留和图像展示轮数复用KNOWLEDGE_AGENT_FILE_CACHE_MAX_FILES、KNOWLEDGE_AGENT_PAGE_DISPLAY_ROUNDS。

# 单进程共享接收器服务探索和个人助理；不会直接连接其他平台或自动创建表。
KNOWLEDGE_PLATFORM_A2A_ENABLED=false
# 首次广播（包括单目标）发布成功后，先缓冲再读取；等全体终态或整轮到期返回。
KNOWLEDGE_PLATFORM_A2A_RESPONSE_BUFFER_SECONDS=5
KNOWLEDGE_PLATFORM_A2A_WAIT_SECONDS=90
KNOWLEDGE_PLATFORM_A2A_POLL_SECONDS=1
KNOWLEDGE_PLATFORM_A2A_HTTP_TIMEOUT_SECONDS=10
KNOWLEDGE_PLATFORM_A2A_MAX_CONCURRENT_REQUESTS=16

# 附件统一转 PDF；容器内使用镜像安装的 LibreOffice，不填写宿主机程序路径。
KNOWLEDGE_OFFICE_CONVERTER_EXECUTABLE=/usr/bin/soffice

# 每页视觉 patch 预算；控制图片分辨率，不是模型实际计费 token 上限。
KNOWLEDGE_PDF_MAX_VISUAL_TOKENS_PER_PAGE=2048
