# MySQL 基础镜像版本，可替换为经过验证的具体补丁版本。
MYSQL_VERSION=8.4

# 数据库及业务账号；业务账号不要设置为 root。
MYSQL_DATABASE=registry
MYSQL_USER=registry

# 首次启动前设置两个不同的非空密码，不要提交真实密码。
# 包含 $ 或 # 等特殊字符的值建议用单引号包裹。
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# 宿主机访问端口，默认仅绑定 127.0.0.1。
MYSQL_PORT=3306

# 后端宿主机端口，仅绑定 127.0.0.1；容器内部监听 8000。
BACKEND_PORT=23000

# 后端模型、平台密钥等配置读取 ../registry-be/.env。
# 覆盖容器内中间件地址，Docker Desktop / Linux 通过 host-gateway 访问宿主机。
MIDDLEWARE_BASE_URL=http://host.docker.internal:22000
