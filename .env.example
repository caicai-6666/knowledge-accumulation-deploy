# MySQL 基础镜像版本，可替换为经过验证的具体补丁版本。
MYSQL_VERSION=8.4

# 数据库及业务账号；业务账号不要设置为 root。
MYSQL_DATABASE=registry
MYSQL_USER=registry

# 首次启动前设置两个不同的非空密码，不要提交真实密码。
# 包含 $ 或 # 等特殊字符的值建议用单引号包裹。
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# 宿主机访问端口，默认仅绑定 127.0.0.1。
MYSQL_PORT=3306

# 后端宿主机端口，仅绑定 127.0.0.1；容器内部监听 8000。
BACKEND_PORT=23000
# registry 实际配置；raw 环境注入，值不添加外围引号。
REGISTRY_BACKEND_ENV_FILE=../registry-be/.env
# registry 前端 Nginx；API 在同一网络直接转发给 backend:8000。
REGISTRY_FRONTEND_PORT=23080

# 知识后端宿主机端口；容器内部监听 8000，固定单 worker。
KNOWLEDGE_BACKEND_PORT=24000
# 相对路径按 Compose 文件所在目录解析；只读挂载，不复制到镜像。
KNOWLEDGE_BACKEND_ENV_FILE=../knowledge-accumulation-be/.env
# 助理、转换子智能体及 A2A 参数在上述文件中维护，不在 deploy .env 重复配置。
# 新增项及默认值见知识后端 .env.example；重点同步：
# ASSISTANT_MODEL_RETRY_SECONDS=30、ASSISTANT_RENDERING_THINKING_EFFORT=medium。
# PLATFORM_A2A_RESPONSE_BUFFER_SECONDS=5、PLATFORM_A2A_POLL_SECONDS=1、
# PLATFORM_A2A_HTTP_TIMEOUT_SECONDS=10、PLATFORM_A2A_MAX_CONCURRENT_REQUESTS=16。
# VLLM_MLLM_* 同样由后端配置读取，主助理与转换器共用该模型服务。

# 统一前端端口，仅绑定 127.0.0.1；容器内部 Nginx 监听 80。
KNOWLEDGE_FRONTEND_PORT=24080
# 前后端共用的钉钉企业公开 CorpId；生产前端构建必填。
# 同时注入后端 DINGTALK_CORP_ID 和前端构建参数 VITE_DINGTALK_CORP_ID。
# 修改后需重建 knowledge-frontend 并重新创建 knowledge-backend。
# AppKey/AppSecret 只放知识后端配置，不作为前端构建参数。
DINGTALK_CORP_ID=

# 后端模型、registry 平台密钥和管理员鉴权配置读取 REGISTRY_BACKEND_ENV_FILE。
# 认证只使用 AUTH_REQUEST_TIMEOUT_SECONDS；管理员全表由知识后端发布。
# 用户登录、用户/管理员全表注册和头像存储由 knowledge-accumulation-be 管理。
# registry 的钉钉通讯录刷新及头像代理超时/大小/缓存配置同样读取该文件。
# 任职资料、多部门刷新沿用 DINGTALK_*，不新增凭据或同步开关。
# 覆盖容器内中间件地址，Docker Desktop / Linux 通过 host-gateway 访问宿主机。
MIDDLEWARE_BASE_URL=http://host.docker.internal:22000

# registry 头像代理使用同一 Compose 网络内的知识后端，不含 API 路径。
KNOWLEDGE_ACCUMULATION_BASE_URL=http://knowledge-backend:8000
